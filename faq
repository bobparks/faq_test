    <script>

      var gotoappinventor = function() {
        var referrer = document.location.pathname;
        var patt = /.*hour-of-code.*/;

        if (referrer.match(patt)) {
          window.open("http://code.appinventor.mit.edu/", "new");
        } else {
          window.open("http://ai2.appinventor.mit.edu/", "new");
        }
      }

      function showPanelFromHash() {
        /**
         * For <button>s of the .accordion class with an id equal to 
         * the location.hash, make the <button> .active, display the 
         * nextElementSibling if it is of the .panel class, and 
         * scrollIntoView the button.
         */
        var id = window.location.hash;

        if (!id) return;

        let button = document.querySelector(id);

        if (button && button.classList.contains("accordion")) {

          button.classList.add("active");

          var panel = button.nextElementSibling;

          if (panel && panel.classList.contains("panel")) {
            panel.style.display = "block";
            button.scrollIntoView();
          }
        }
      }

      document.addEventListener("DOMContentLoaded", function() {
        /* Add this function to all .accordion class elements. */

        for (const button of document.querySelectorAll(".accordion")) {
          button.addEventListener("click", function() {
            /**
             * Toggle .active class for this and toggle style.display 
             * between "none" & "block" for the nextElementSibling.
             */
            this.classList.toggle("active");

            var panel = this.nextElementSibling;

            /* Toggle style.display between "none" & "block" for 
             * this.nextElementSibling panel.
             * NOTE: no check that panel is of the .panel class
             */
            if (panel.style.display === "block") {
              panel.style.display = "none";
            } else {
              panel.style.display = "block";
            }
          });
        }

        showPanelFromHash();  /* do once on DOMContentLoaded */

      });

      window.addEventListener("hashchange", showPanelFromHash);

    </script>
